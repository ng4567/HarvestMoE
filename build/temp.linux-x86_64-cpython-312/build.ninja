ninja_required_version = 1.3
cxx = c++

cflags = -fno-strict-overflow -Wsign-compare -DNDEBUG -g -O2 -Wall -fPIC -I/home/azureuser/vllm/.venv/lib/python3.12/site-packages/torch/include -I/home/azureuser/vllm/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/azureuser/vllm/.venv/include -I/home/azureuser/vllm/.venv/include -I/usr/include/python3.12 -c
post_cflags = -std=c++17 -O1 -fopenmp -Wno-ignored-qualifiers -mf16c -mavx512f -mavx512cd -mavx512vl -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_cpu_kernel
